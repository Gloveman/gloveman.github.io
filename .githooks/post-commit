#!/bin/sh
# .githooks/post-commit
# 커밋 완료 후 자동으로 원격 저장소에 push를 시도합니다.

# 현재 브랜치 이름 가져오기
BRANCH=$(git symbolic-ref --short HEAD)

echo "🚀 Auto-pushing changes to remote branch '$BRANCH'..."
git push origin "$BRANCH"

if [ $? -eq 0 ]; then
  echo "✅ Successfully synced with GitHub!"
else
  echo "⚠️ Auto-push failed. Please push manually."
fi
